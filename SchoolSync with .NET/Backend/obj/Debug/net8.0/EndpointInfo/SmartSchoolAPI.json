          "gender",
          "lastName",
          "motherName",
          "motherOccupation",
          "motherPhone",
          "phone",
          "pincode",
          "state"
        ],
        "type": "object",
        "properties": {
          "admissionId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "firstName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "gender": {
            "minLength": 1,
            "type": "string"
          },
